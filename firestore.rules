rules_version = '2';

// Firebase 콘솔 → Firestore → 규칙에 그대로 붙여 넣어요.
service cloud.firestore {
  match /databases/{database}/documents {

    function myEmail() {
      return request.auth.token.email.lower();
    }
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    // admins/{이메일} 문서가 있으면 관리자
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(myEmail()));
    }

    function validPost() {
      let d = request.resource.data;
      return d.keys().hasOnly(['title', 'category', 'date', 'body', 'links', 'pinned',
                               'speaker', 'affiliation', 'time', 'place', 'updatedAt', 'updatedBy'])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 200
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.body is string && d.body.size() <= 50000
        && d.pinned is bool
        && d.links is list && d.links.size() <= 10;
    }

    match /admins/{email} {
      // 본인 문서는 읽을 수 있어야 관리자인지 확인할 수 있어요
      allow read: if isAdmin() || (signedIn() && email == myEmail());
      allow create: if isAdmin() && email == email.lower();
      allow delete: if isAdmin() && email != myEmail();
    }

    // 공개 게시판: 누구나 읽고, 관리자만 씀
    match /notices/{id} {
      allow read: if true;
      allow create, update: if isAdmin() && validPost();
      allow delete: if isAdmin();
    }
    match /seminars/{id} {
      allow read: if true;
      allow create, update: if isAdmin() && validPost();
      allow delete: if isAdmin();
    }
    match /news/{id} {
      allow read: if true;
      allow create, update: if isAdmin() && validPost();
      allow delete: if isAdmin();
    }

    // 메일 받는 사람 명단: 관리자만
    match /recipients/{email} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin() && email == email.lower()
        && request.resource.data.email == email
        && request.resource.data.groups is list;
    }

    // 발송 기록
    match /campaigns/{id} {
      allow read, create: if isAdmin();
    }

    // Trigger Email 확장 프로그램이 읽어서 cmri@knu.ac.kr로 보내는 곳.
    // 보내는 주소(from)·회신 주소는 바꿀 수 없고, 한 문서에 숨은참조 50명까지.
    match /mail/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['to', 'bcc', 'message', 'campaignId', 'createdAt'])
        && request.resource.data.to == 'cmri@knu.ac.kr'
        && request.resource.data.bcc is list
        && request.resource.data.bcc.size() > 0 && request.resource.data.bcc.size() <= 50
        && request.resource.data.message.keys().hasOnly(['subject', 'text', 'html'])
        && exists(/databases/$(database)/documents/campaigns/$(request.resource.data.campaignId));
    }
  }
}
