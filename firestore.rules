rules_version = '2';

// Firebase 콘솔 → Firestore → 규칙에 그대로 붙여 넣어요.
service cloud.firestore {
  match /databases/{database}/documents {

    function myEmail() {
      return request.auth.token.email.lower();
    }
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    // admins/{이메일} 문서가 있으면 관리자
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(myEmail()));
    }

    function validPost() {
      let d = request.resource.data;
      return d.keys().hasOnly(['title', 'category', 'date', 'body', 'links', 'pinned',
                               'speaker', 'affiliation', 'time', 'place', 'updatedAt', 'updatedBy'])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 200
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.body is string && d.body.size() <= 50000
        && d.pinned is bool
        && d.links is list && d.links.size() <= 10;
    }

    function text(v, max) {
      return v is string && v.size() <= max;
    }
    function validFaculty() {
      let d = request.resource.data;
      let photo = d.get('photo', '');
      return d.keys().hasOnly(['nameKo', 'nameEn', 'role', 'positionKo', 'positionEn', 'deptKo', 'deptEn',
                               'researchKo', 'researchEn', 'email', 'photo', 'director', 'updatedAt', 'updatedBy'])
        && d.nameKo is string && d.nameKo.size() > 0 && d.nameKo.size() <= 50
        && d.role in ['faculty', 'visiting', 'postdoc', 'researcher']
        && text(d.get('nameEn', ''), 100)
        && text(d.get('positionKo', ''), 50) && text(d.get('positionEn', ''), 100)
        && text(d.get('deptKo', ''), 100) && text(d.get('deptEn', ''), 200)
        && text(d.get('researchKo', ''), 200) && text(d.get('researchEn', ''), 300)
        && text(d.get('email', ''), 200)
        && d.get('director', false) is bool
        // 사진은 관리자 화면에서 줄인 JPEG만
        && (photo == '' || (text(photo, 100000) && photo.matches('data:image/jpeg;base64,[A-Za-z0-9+/=]+')));
    }

    // 신청·제출(연구비·포상·업적)은 로그인 없이 누구나. 이메일은 신청자가 적은 주소예요
    function validApplication() {
      let d = request.resource.data;
      return d.keys().hasOnly(['email', 'type', 'name', 'dept', 'position', 'phone', 'amount',
                               'details', 'memo', 'files', 'status', 'createdAt'])
        && d.email is string && d.email.size() <= 200 && d.email.matches('[^@\\s]+@[^@\\s]+[.][^@\\s]+')
        && d.type in ['publication', 'proposal', 'editing',
                      'academic-award', 'paper-award', 'young-scientist', 'research-note', 'photo-contest',
                      'achievement']
        && d.name is string && d.name.size() > 0 && d.name.size() <= 50
        && d.dept is string && d.dept.size() > 0 && d.dept.size() <= 100
        && text(d.get('position', ''), 50)
        && d.phone is string && d.phone.size() > 0 && d.phone.size() <= 30
        // 신청 금액은 연구비 지원에만 있어요
        && (d.type in ['publication', 'proposal', 'editing']) == ('amount' in d)
        && (!('amount' in d) || (d.amount is int && d.amount > 0 && d.amount <= 100000000))
        && d.details is map && d.details.size() <= 10
        && text(d.get('memo', ''), 2000)
        && d.files is list && d.files.size() <= 5
        && d.status == 'submitted'
        && d.createdAt == request.time;
    }

    // 관리자가 구성원에게 보내는 메일 (숨은참조 50명씩)
    function validCampaignMail() {
      let d = request.resource.data;
      return d.keys().hasOnly(['to', 'bcc', 'message', 'campaignId', 'createdAt'])
        && d.to == 'cmri@knu.ac.kr'
        && d.bcc is list && d.bcc.size() > 0 && d.bcc.size() <= 50
        && d.message.keys().hasOnly(['subject', 'text', 'html'])
        && exists(/databases/$(database)/documents/campaigns/$(d.campaignId));
    }
    // 신청·제출 알림 (글만, 받는 사람 한 명)
    function validNotice(id) {
      let d = request.resource.data;
      let appPath = /databases/$(database)/documents/applications/$(d.applicationId);
      return d.keys().hasOnly(['to', 'message', 'applicationId', 'createdAt'])
        && d.message.keys().hasOnly(['subject', 'text'])
        && text(d.message.subject, 200) && text(d.message.text, 10000)
        && exists(appPath)
        && (
          // 새 신청: 신청마다 한 번(메일 문서 ID = 신청 ID), 연구소 메일로만
          (id == d.applicationId && d.to == 'cmri@knu.ac.kr')
          // 결과: 관리자가 그 신청자에게만
          || (isAdmin() && d.to == get(appPath).data.email)
        );
    }

    match /admins/{email} {
      // 본인 문서는 읽을 수 있어야 관리자인지 확인할 수 있어요
      allow read: if isAdmin() || (signedIn() && email == myEmail());
      allow create: if isAdmin() && email == email.lower();
      allow delete: if isAdmin() && email != myEmail();
    }

    // 공개 게시판: 누구나 읽고, 관리자만 씀
    match /notices/{id} {
      allow read: if true;
      allow create, update: if isAdmin() && validPost();
      allow delete: if isAdmin();
    }
    match /seminars/{id} {
      allow read: if true;
      allow create, update: if isAdmin() && validPost();
      allow delete: if isAdmin();
    }
    match /news/{id} {
      allow read: if true;
      allow create, update: if isAdmin() && validPost();
      allow delete: if isAdmin();
    }
    match /newsletters/{id} {
      allow read: if true;
      allow create, update: if isAdmin() && validPost();
      allow delete: if isAdmin();
    }

    // 연구진: 누구나 읽고(연구소 소개 → 연구진), 관리자만 씀
    match /faculty/{id} {
      allow read: if true;
      allow create, update: if isAdmin() && validFaculty();
      allow delete: if isAdmin();
    }

    // 신청·제출: 누구나 새로 내기만 하고, 보는 건 관리자만. 관리자는 결과(상태·안내)만 고쳐요
    match /applications/{id} {
      allow read: if isAdmin();
      allow create: if validApplication();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'note', 'decidedAt', 'decidedBy'])
        && request.resource.data.status in ['submitted', 'approved', 'rejected']
        && text(request.resource.data.get('note', ''), 2000);
      allow delete: if isAdmin();
    }

    // 메일 받는 사람 명단: 관리자만
    match /recipients/{email} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin() && email == email.lower()
        && request.resource.data.email == email
        && request.resource.data.groups is list;
    }

    // 발송 기록
    match /campaigns/{id} {
      allow read, create: if isAdmin();
    }

    // 메일 함수(functions/index.js)가 읽어서 cmri@knu.ac.kr 이름으로 보내는 곳.
    // 보내는 주소(from)·회신 주소는 바꿀 수 없어요.
    match /mail/{id} {
      allow read: if isAdmin();
      allow create: if (isAdmin() && validCampaignMail()) || validNotice(id);
    }
  }
}
